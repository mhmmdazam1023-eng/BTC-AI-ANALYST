# ============================================================
# Bitcoin AI Analyst - environment variables
# Copy this file to `.env` and fill in the secrets.
# NEVER commit the real `.env` file (it is git-ignored).
# ============================================================

# --- PostgreSQL / TimescaleDB (must match docker-compose.yml) ---
POSTGRES_USER=btc_analyst
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitcoin_ai

# --- Qwen AI (OpenAI-compatible endpoint) ---
# Example (Alibaba DashScope international): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=4

# --- External data API keys (dibutuhkan mulai Phase 2) ---
FRED_API_KEY=
GLASSNODE_API_KEY=

# Host data publik Binance. Default: mirror resmi data-api.binance.vision
# (api.binance.com diblokir ISP Indonesia). Kosongkan untuk default ccxt.
BINANCE_PUBLIC_API_URL=https://data-api.binance.vision/api/v3

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development
